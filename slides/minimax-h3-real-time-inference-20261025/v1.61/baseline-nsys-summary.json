    "classification": {
      "method": "Explicit first-match kernel-name rules across all stages; original NVTX stage attribution retained.",
      "rules": [
        {
          "id": "nccl",
          "category": "NCCL",
          "pattern": "(?:nccl|msccl)"
        },
        {
          "id": "attention",
          "category": "Attention",
          "pattern": "(?:flash[_:]?(?:attn|attention)|flash_(?:fwd|bwd)|flashattention|fmha|fused.?multi.?head.?attention|scaled.?dot.?product|memory.?efficient.?attention|(?:^|[_:])sdpa(?:[_:<]|$)|cudnn[^\\n]*sdpa|(?:^|[_:])attention(?:[_:<]|$)|(?:^|[_:])attn(?:[_:<]|$))"
        },
        {
          "id": "convolution",
          "category": "Convolution",
          "pattern": "(?:xmma_(?:fprop|dgrad|wgrad)_implicit_gemm|implicit_convolve|(?:^|[_:])conv(?:[123]d|olution|_fwd|_dgrad|_wgrad)|(?:^|[_:])(?:im2col|col2im|vol2col)|cudnn[^\\n]*convolve)"
        },
        {
          "id": "gemm",
          "category": "GEMM",
          "pattern": "(?:gemm|gemv|matmul|cutlass::Kernel|cutlass_kernel|wgmma|tensorop|cublas|triton[^\\n]*(?:persistent_mm|scaled_mm|addmm)|(?:^|[_:])b?mm(?:[_:<]|$)|(?:^|[_:])addmm(?:[_:<]|$))"
        },
        {
          "id": "layout",
          "category": "Layout / device copies",
          "pattern": "(?:memcpy|memmove|copy_kernel|direct_copy|copy_if|copy_device|CatArrayBatchedCopy|concat|concatenate|transpose|permute|nchwToNhwc|nhwcToNchw|tensorTransformGeneric|contiguous|gather_kernel|scatter_kernel|_scatter_gather_elementwise_kernel|indexFunc|index_(?:select|put)|indexSelect(?:Small|Large)Index|index_elementwise|pack_kernel|unpack_kernel|split_with_sizes_copy|ConvertTo|convert_kernel|cast_kernel|typecast|FillFunctor|fill_kernel)"
        },
        {
          "id": "pointwise",
          "category": "Norm / activation / elementwise",
          "pattern": "(?:rms.?norm|layer.?norm|group.?norm|batch.?norm|act_and_mul|silu|swiglu|geglu|gelu|glu_kernel|fused.?mlp|elementwise|indexed_gate|norm_indexed|norm_scale|rope|rotary|softmax|reduce_kernel|Reduce(?:\\.cuh|\\.cu)|vectorized.*?kernel|unrolled.*?kernel)"
        }
      ],
      "unmatched_category": "Other kernels",
      "fused_kernel_accounting": "The complete fused kernel duration stays in its matched category. Attention is not split into internal matrix products; fused GEMM epilogues stay in GEMM. Explicit implicit-GEMM convolution kernels are classified as Convolution."
    },
    "validation": {
      "source_strict_acceptance": true,
      "independent_nsys_totals": true,
      "categories_partition_total": true,
      "per_device_matches_grouped_names": true
    },
    "limitations": [
      "Aggregate GPU operation durations overlap across devices and streams; these are not additive E2E critical-path times.",
      "NCCL duration includes synchronization and waiting; it is not a direct bandwidth or network-transfer measurement.",
      "Kernel categories are explicit name-based classifications; unmatched names remain visible in Other kernels.",
      "The denominator excludes CPU-only work and GPU idle gaps."
    ],
