  "scope": "One native prequantized BSA call per provider and capture; quantization, allocation, routing and warmup are outside the profiler range.",
  "definitions": {
    "kb": "Decimal kilobytes (1000 bytes), following the Nsight Compute export.",
    "tensor_active_pct_elapsed": "Percent of elapsed cycles with the Tensor pipeline active; not percent of peak FLOP/s.",
    "executed_warp_instructions": "smsp__inst_executed.sum; keep separate from FP32 rule instruction counts.",
    "fp32_instruction_counts": "Values reported by the Nsight Compute FP32 fused/non-fused instruction rule.",
    "metric_keys_and_units": {
      "profiled_duration_ms": {
        "metric": "gpu__time_duration.sum",
        "export_unit": "ms"
      },
      "registers_per_thread": {
        "metric": "launch__registers_per_thread",
        "export_unit": "register/thread"
      },
      "dynamic_shared_memory_kb_per_block": {
        "metric": "launch__shared_mem_per_block_dynamic",
        "export_unit": "Kbyte/block"
      },
      "allocated_shared_memory_kb_per_block": {
        "metric": "launch__shared_mem_per_block_allocated",
        "export_unit": "Kbyte/block"
      },
      "register_limited_blocks_per_sm": {
        "metric": "launch__occupancy_limit_registers",
        "export_unit": "block"
      },
      "shared_memory_limited_blocks_per_sm": {
        "metric": "launch__occupancy_limit_shared_mem",
        "export_unit": "block"
      },
      "achieved_occupancy_pct": {
        "metric": "sm__warps_active.avg.pct_of_peak_sustained_active",
        "export_unit": "%"
      },
      "tensor_active_pct_elapsed": {
        "metric": "sm__pipe_tensor_cycles_active.avg.pct_of_peak_sustained_elapsed",
        "export_unit": "%"
      },
      "tensor_hmma_active_pct_elapsed": {
        "metric": "sm__pipe_tensor_subpipe_hmma_cycles_active.avg.pct_of_peak_sustained_elapsed",
        "export_unit": "%"
      },
      "tensor_imma_active_pct_elapsed": {
        "metric": "sm__pipe_tensor_subpipe_imma_cycles_active.avg.pct_of_peak_sustained_elapsed",
        "export_unit": "%"
      },
      "executed_warp_instructions": {
        "metric": "smsp__inst_executed.sum",
        "export_unit": "inst"
      },
      "dram_bandwidth_gb_per_s": {
        "metric": "dram__bytes.sum.per_second",
        "export_unit": "Gbyte/s"
      },
      "dram_active_pct_peak": {
        "metric": "dram__cycles_active.avg.pct_of_peak_sustained_elapsed",
        "export_unit": "%"
      },
      "l2_hit_rate_pct": {
        "metric": "lts__t_sector_hit_rate.pct",
        "export_unit": "%"
      },
      "average_sm_clock_ghz": {
        "metric": "gpc__cycles_elapsed.avg.per_second",
        "export_unit": "Ghz"
      },
      "local_spilling_requests": {
        "metric": "derived__local_spilling_requests",
        "export_unit": ""
      }
    }
  },
  "source_observations": {
    "cudnn": {
      "url": "https://github.com/NVIDIA/cudnn-frontend/blob/351f7302a528641e741e3d9c77801194abdb5ccc/python/cudnn/block_sparse_attention/csrc/fwd/sm120_blk64/bsa_fwd_sm120_fp8.py",
      "observation": "SharedStorage declares separate Q, K, V and O buffers. Q scales are per row; K scales cover 16 keys."
    },
    "cake": {
      "url": "https://github.com/lishunyang12/flashinfer/blob/e91eefc725d6fb7080bc9a713bfd7efb868efcc6/csrc/cake_sage_block_sparse_attention/sm_120a/cake_sage_block_sparse_attention_bd48d91a04a229511902_kernel.cu",
      "observation": "O starts at shared-memory offset 1024, reusing Q/K staging storage after the attention loop. Q scales cover 32 rows; K scales cover 64 keys. Kernel launch bounds specify 128 threads and 3 blocks."
    }
  },
  "interpretation": "Lower register and shared-memory requirements allow CAKE to sustain higher occupancy. Fewer executed instructions and higher Tensor pipeline activity are consistent with its shorter kernel latency. Source structure suggests buffer reuse and coarser scale handling as contributors; no ablation apportions their effects.",
  "limitations": [
    "The GPU was shared with a resident service and was not exclusively reserved. Utilization was 0% before each run; overlap during profiling cannot be excluded.",
    "Clocks were not locked and caches were not flushed. Counter collection used multiple replay passes.",
    "Profiled native-call durations are separate observations and do not replace the 30-sample CUDA Graph benchmark medians.",
    "Q/K formats differ: cuDNN uses FP8 E4M3; CAKE uses INT8. Both use FP8 V and BF16 output.",
    "No source-PC stall attribution or performance ablation was performed. Aggregate counters do not assign a causal share to each source difference."
  ],
